---
const pathname = Astro.url.pathname;
const nav = [
  ["/como-funciona/", "Como funciona"],
  ["/planos/", "Planos"],
  ["/seguranca/", "Segurança"],
  ["/releases/", "Releases"],
];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="ProxyEdu — página inicial">
      <img src="/assets/logo.svg" width="38" height="38" alt="" />
      <span>ProxyEdu</span>
    </a>
    <nav aria-label="Navegação principal">
      {nav.map(([href, label]) => <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>)}
    </nav>
    <a class="button button-small" href="/trial/">Solicitar avaliação</a>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Navegação móvel">
        {nav.map(([href, label]) => <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>)}
        <a href="/trial/">Solicitar avaliação</a>
      </nav>
    </details>
  </div>
</header>
